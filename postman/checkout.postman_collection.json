  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('API reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Total for $100",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is JSON', () => pm.response.to.have.header('Content-Type', 'application/json'));",
              "const body = pm.response.json();",
              "pm.test('Total is 108', () => pm.expect(body.total).to.eql(108));",
              "pm.test('Tax is 8', () => pm.expect(body.tax).to.eql(8));",
              "pm.test('Tax rate is 8%', () => pm.expect(body.taxRate).to.eql(0.08));",
              "pm.test('Responds in under 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "checkout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"subtotal\": 100}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
